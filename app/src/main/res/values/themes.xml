<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Lev.Dark" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/dark_bg</item>
        <item name="android:colorPrimary">@color/dark_bg</item>
        <item name="android:colorPrimaryDark">@color/dark_bg</item>
        <item name="android:colorAccent">#FFFFFFFF</item>
        <item name="android:statusBarColor">@color/dark_bg</item>
        <item name="android:navigationBarColor">@color/dark_bar</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="Theme.Lev.Light" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/light_bg</item>
        <item name="android:colorPrimary">@color/light_bg</item>
        <item name="android:colorPrimaryDark">@color/light_bg</item>
        <item name="android:colorAccent">#FF111113</item>
        <item name="android:statusBarColor">@color/light_bg</item>
        <item name="android:navigationBarColor">@color/light_bar</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
